{
  "name": "create-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: Skills page — install from the catalog, create and edit skills, watch the prompt budget, compare two skill versions.",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "catalog/catalog.json",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "skills",
    "ui"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "validate:catalog": "node scripts/validate-catalog.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
