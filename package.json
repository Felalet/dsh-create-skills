{
  "name": "create-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin: skills catalog with preview, editor, versions, archive (trash) and A/B comparison with AI improvement.",
  "license": "MIT",
  "author": "VladSparrow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Felalet/dsh-create-skills.git"
  },
  "homepage": "https://github.com/Felalet/dsh-create-skills#readme",
  "bugs": {
    "url": "https://github.com/Felalet/dsh-create-skills/issues"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "catalog/catalog.json",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "skills",
    "agent-skills",
    "ui"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "check": "node scripts/check-client.mjs",
    "test": "node scripts/check-client.mjs && node scripts/validate-catalog.mjs && node scripts/test-archive.mjs",
    "test:preview": "node scripts/test-preview.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
